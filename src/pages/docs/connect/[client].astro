---
import DocsSection from '../../../layouts/DocsSection.astro';
import GuideInstructions from '../../../components/GuideInstructions.astro';
import guides from '../../../data/app-guides.json';

export function getStaticPaths() {
  return guides.apps.map((app) => ({
    params: { client: app.id },
    props: { app, checked: guides.checked },
  }));
}

const { app, checked } = Astro.props;
const description = 'Setup steps for ' + app.name + ' with this Azizam gateway.';
---
<DocsSection
  title={app.name + ' setup · Azizam docs'}
  heading={app.name}
  description={description}
  activeSection="connect"
  clientGuides={guides.apps.map(({ id, name }) => ({ id, name }))}
  currentClientId={app.id}
  breadcrumbs={[{ label: 'Docs', href: '/docs/' }, { label: 'Connect', href: '/docs/connect/' }, { label: app.name }]}
>
  <p class="client-kind">{app.kind}</p>
  {app.key && <GuideInstructions title="Connect with a key" checked={checked} guide={app.key} clientName={app.name} />}
  {app.mcp && <GuideInstructions title="Connect with MCP" checked={checked} guide={app.mcp} clientName={app.name} />}
  <p class="all-guides"><a href="/docs/connect/">All client guides</a></p>
</DocsSection>
