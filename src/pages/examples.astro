---
import Base from '../layouts/Base.astro';
import groups from '../data/examples.json';
import '../styles/examples.css';

const pretty = (value: unknown) => (typeof value === 'string' ? value : JSON.stringify(value, null, 2));
---
<Base title="Examples · Azizam" description="Request shapes for the APIs Azizam exposes. Responses depend on the engines and providers you configure." bodyClass="examples">
  <div class="examples-intro wrap">
    <h1>Examples</h1>
    <p class="lede">These examples show request shapes. Responses depend on the engines and providers you configure.</p>
    <nav aria-label="Jump to a request type">
      <ul class="chips">
        {groups.map((group) => <li><a href={`#${group.id}`}>{group.title}</a></li>)}
      </ul>
    </nav>
  </div>
  <main id="content" class="wrap" tabindex="-1">
    {groups.map((group) => (
      <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <h2 id={`${group.id}-title`}>{group.title}</h2>
        <p>{group.blurb}</p>
        <div class="example-list">
          {group.examples.map((example) => (
            <article class="example" id={example.id} aria-labelledby={`${example.id}-title`}>
              <h3 id={`${example.id}-title`}>{example.title}</h3>
              {example.inputs.map((input) => (
                <div>
                  <p class="label">{input.label}</p>
                  <pre class:list={[input.kind === 'text' && 'prompt']} tabindex="0">{pretty(input.value)}</pre>
                </div>
              ))}
            </article>
          ))}
        </div>
      </section>
    ))}
    <p class="more"><a href="/docs/api/">Read the API guides</a> · <a href="/docs/start/install/">Set up your gateway</a></p>
  </main>
</Base>
