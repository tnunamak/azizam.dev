---
import Base from '../layouts/Base.astro';
import { GET_STARTED } from '../config';
import '../styles/home.css';

const productDescription =
  'Azizam is a self-hosted gateway. Point the apps you already use at it. Each person and app gets its own key and plan, requests run on your own engines first, and Usage records who asked, which model ran, and where.';
---
<Base title="One address for the AI you run · Azizam" description={productDescription} bodyClass="home">
  <main id="content" tabindex="-1" class="home">
    <section class="hero wrap" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">One address for the AI you run.</h1>
        <p class="hero-description">{productDescription}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" data-cta href={GET_STARTED}>Read the setup guide</a>
          <a class="btn btn-secondary" data-cta href="#how">See how it works</a>
        </div>
        <p class="preview-note">Private preview. Access is by invitation from the person who runs the gateway.</p>
      </div>

      <figure class="product-proof" aria-labelledby="proof-caption">
        <picture>
          <source srcset="/images/apps-keys-hero-phone-dark.webp" media="(max-width: 900px) and (prefers-color-scheme: dark)" width="340" height="397" />
          <source srcset="/images/apps-keys-hero-phone-light.webp" media="(max-width: 900px)" width="340" height="397" />
          <source srcset="/images/apps-keys-hero-desktop-dark.webp" media="(prefers-color-scheme: dark)" width="1100" height="245" />
          <img
            src="/images/apps-keys-hero-desktop-light.webp"
            width="1100"
            height="245"
            alt="Apps and keys: an app card with its access plan, a key row, and an add-key action."
            fetchpriority="high"
          />
        </picture>
        <figcaption id="proof-caption">Apps &amp; keys, with demo data.</figcaption>
      </figure>
    </section>

    <section id="how" class="how wrap" aria-label="How it works">
      <p class="how-line">
        <span>Your apps</span>
        <span class="arrow" aria-hidden="true">→</span>
        <span>Azizam (key, plan, usage)</span>
        <span class="arrow" aria-hidden="true">→</span>
        <span>your engines, or a provider you allow</span>
      </p>
    </section>

    <section id="features" class="claims wrap" aria-labelledby="claims-title">
      <h2 id="claims-title">What it gives you</h2>
      <div class="claim-list">
        <article class="claim-row">
          <h3>One address</h3>
          <p>Connect your apps through Azizam's supported OpenAI, Anthropic, and Ollama API routes. Agents can connect through MCP.</p>
        </article>
        <article class="claim-row">
          <h3>A key and plan for each person and app</h3>
          <p>Each person and app has its own key and access plan. The plan sets which models it may use and its spend cap.</p>
        </article>
        <article class="claim-row">
          <h3>Your engines first</h3>
          <p>Requests run on your own engines first. A paid provider is used only when the access plan allows it.</p>
        </article>
        <article class="claim-row">
          <h3>A record of each request</h3>
          <p>Usage shows who asked, which model ran, where it ran, and what it cost.</p>
        </article>
      </div>
    </section>

    <section id="setup" class="setup wrap" aria-labelledby="setup-title">
      <h2 id="setup-title">Set it up</h2>
      <p>If you run a gateway, the setup guide covers installing it and inviting the people who use it. <a href="/docs/start/install/">Read the setup guide</a></p>
    </section>

    <section id="limits" class="limits wrap" aria-labelledby="limits-title">
      <h2 id="limits-title">Before you rely on it</h2>
      <ul class="facts">
        <li>You supply and maintain your engines and model files. Azizam connects to them; it does not install them.</li>
        <li>Compatibility depends on the route. The <a href="/docs/api/">API guides</a> list supported methods and their limits.</li>
        <li>Spend caps use recorded spend. Requests already running can exceed a cap before their final cost is known. Set a provider credit limit too.</li>
        <li>You run the host, including updates, backups, and HTTPS for access from other devices.</li>
      </ul>
    </section>
  </main>
</Base>
