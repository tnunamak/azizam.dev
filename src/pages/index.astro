---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import AudioChip from '../components/AudioChip.astro';
import { GET_STARTED } from '../config';
import recorded from '../data/recorded.json';
import peaks from '../data/audio-peaks.json';
import '../styles/home.css';

const productDescription =
  'Azizam is a self-hosted gateway. Point the apps you already use at it. Each person and app gets its own key and plan, requests run on your own engines first, and Usage records who asked, which model ran, and where.';
const recordedOn = '28 October 2026';

// The chat answer is model output. Keep its line breaks and bold headings, drop nothing else.
const answerLines = [];
for (const raw of recorded.chat.answer.split('\n')) {
  const line = raw.trim();
  if (!line) continue;
  const bullet = /^\*\s+/.test(line);
  const text = bullet ? line.replace(/^\*\s+/, '') : line;
  const last = answerLines.at(-1);
  if (bullet) {
    if (last?.kind === 'ul') last.items.push(text);
    else answerLines.push({ kind: 'ul', items: [text] });
  } else {
    answerLines.push({ kind: 'p', text });
  }
}
// The first blocks show when the reply is folded; the rest sit inside the native details.
const foldedLines = answerLines.slice(0, 5);
const restLines = answerLines.slice(5);
// Split on ** so that odd segments render as <strong>.
const bold = (text) => text.split('**');
const speechPeaks = peaks['use-speech.mp3'];
const musicPeaks = peaks['use-music.mp3'];
const wallLead = recorded.images[0];
---
<Base title="AI for your people. On your terms. · Azizam" description={productDescription} bodyClass="home">
  <main id="content" tabindex="-1" class="home">
    <section class="hero wrap" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow"><Mark size={22} /> Self-hosted AI gateway</p>
        <h1 id="home-title">
          <span class="h1-line">AI for your people.</span>
          <span class="h1-line h1-accent">On your terms.</span>
        </h1>
        <p class="hero-description">Azizam runs the image, speech, music and chat models you set up, and gives each person and app its own key and access plan.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" data-cta href={GET_STARTED}>Read the setup guide</a>
          <a class="btn btn-secondary" data-cta href="/docs/api/">API guides</a>
        </div>
        <p class="preview-note">Private preview. Access is by invitation from the person who runs the gateway.</p>
      </div>

      <figure class="wall">
        <figcaption class="wall-head">
          <span>Made through Azizam · {recordedOn}</span>
        </figcaption>
        <div class="wall-grid">
          {recorded.images.map((image) => (
            <div class="tile">
              <img
                src={image.src}
                width="640"
                height="640"
                loading={image.id === wallLead.id ? 'eager' : 'lazy'}
                fetchpriority={image.id === wallLead.id ? 'high' : undefined}
                alt={image.alt}
              />
              <span class="tile-label">{image.tag}</span>
            </div>
          ))}
        </div>
        <div class="wall-audio">
          <AudioChip src="/media/use-speech.mp3" title={recorded.speech.title} duration={recorded.speech.duration} model={recorded.speech.model} peaks={speechPeaks.peaks} />
          <p class="receipt-id">Speech receipt {recorded.speech.receipt}</p>
        </div>
      </figure>
    </section>

    <section id="use" class="chapter wrap" aria-labelledby="use-title">
      <p class="eyebrow">Use</p>
      <h2 id="use-title">What people make with it</h2>
      <p class="chapter-lede">Each item is one request sent through Azizam. The content is unedited; files are resized for the web.</p>

      <div class="use-grid">
        <figure class="artifact artifact-audio">
          <p class="artifact-head">Music · <code>{recorded.music.requested}</code> → <code>{recorded.music.resolved}</code></p>
          <AudioChip src="/media/use-music.mp3" title={recorded.music.title} duration={recorded.music.duration} model={recorded.music.model} peaks={musicPeaks.peaks} />
          <figcaption>Recorded through Azizam on {recordedOn}. <span class="receipt-id">{recorded.music.receipt}</span></figcaption>
        </figure>

        <figure class="artifact artifact-chat">
          <p class="artifact-head">Chat · <code>{recorded.chat.requested}</code> → <code>{recorded.chat.resolved}</code></p>
          <div class="thread">
            <p class="bubble bubble-user">{recorded.chat.prompt}</p>
            <div class="bubble bubble-reply">
              <div class="reply-folded">
                {foldedLines.map((line) =>
                  line.kind === 'ul' ? (
                    <ul>{line.items.map((item) => <li>{bold(item).map((s, i) => (i % 2 ? <strong>{s}</strong> : s))}</li>)}</ul>
                  ) : (
                    <p>{bold(line.text).map((s, i) => (i % 2 ? <strong>{s}</strong> : s))}</p>
                  ),
                )}
              </div>
              <details class="reply-more">
                <summary>Read the full answer</summary>
                {restLines.map((line) =>
                  line.kind === 'ul' ? (
                    <ul>{line.items.map((item) => <li>{bold(item).map((s, i) => (i % 2 ? <strong>{s}</strong> : s))}</li>)}</ul>
                  ) : (
                    <p>{bold(line.text).map((s, i) => (i % 2 ? <strong>{s}</strong> : s))}</p>
                  ),
                )}
              </details>
            </div>
          </div>
          <figcaption>Recorded through Azizam on {recordedOn}. <span class="receipt-id">{recorded.chat.receipt}</span></figcaption>
        </figure>
      </div>

      <figure class="artifact receipts-table">
        <table>
          <caption>The four images in the wall</caption>
          <thead>
            <tr><th scope="col">Image</th><th scope="col">Asked for</th><th scope="col">Ran as</th><th scope="col">Receipt</th><th scope="col">Time</th></tr>
          </thead>
          <tbody>
            {recorded.images.map((image) => (
              <tr>
                <td><img src={image.src} width="56" height="56" alt="" loading="lazy" /> {image.tag}</td>
                <td><code>{image.requested}</code></td>
                <td><code>{image.resolved}</code></td>
                <td><code class="receipt-id">{image.receipt}</code></td>
                <td>{image.latency}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <figcaption>Recorded through Azizam on {recordedOn}. Cost is not recorded for these local engines.</figcaption>
      </figure>
    </section>

    <section id="share" class="chapter wrap" aria-labelledby="share-title">
      <p class="eyebrow">Share</p>
      <h2 id="share-title">A key and a plan for each person and app</h2>
      <p class="chapter-lede">
        A key belongs to one person or app. Its access plan sets which models it may use and the spend cap for it. Revoke the key and that person or app stops.
      </p>
      <figure class="artifact holders" aria-labelledby="holders-title">
        <figcaption class="holders-head">
          <span id="holders-title">Holders and plans</span>
          <span class="example-tag">Example</span>
        </figcaption>
        <ul>
          <li>
            <span class="holder-name">Family</span>
            <span class="chips"><span class="chip-plan">chat</span><span class="chip-plan">images</span></span>
            <span class="cap">$5 / month</span>
          </li>
          <li>
            <span class="holder-name">Kids' tablet</span>
            <span class="chips"><span class="chip-plan">chat only</span></span>
            <span class="cap">$1 / month</span>
          </li>
          <li>
            <span class="holder-name">Home Assistant voice</span>
            <span class="chips"><span class="chip-plan">speech</span></span>
            <span class="cap cap-unset">no cap set</span>
          </li>
        </ul>
        <p class="holders-note">Example values, not a screenshot and not a price. Your gateway's keys and caps are set in Apps &amp; keys.</p>
      </figure>
    </section>

    <section id="understand" class="chapter wrap" aria-labelledby="understand-title">
      <p class="eyebrow">Understand</p>
      <h2 id="understand-title">Every request leaves a receipt</h2>
      <p class="chapter-lede">
        Usage shows who asked, which model ran, where it ran and what it cost. This is the receipt for the plate image in the wall, with the app name removed.
      </p>
      <figure class="artifact receipt">
        <dl>
          {recorded.receipt_detail.map(([term, value]) => (
            <div><dt>{term}</dt><dd>{value}</dd></div>
          ))}
        </dl>
        <figcaption>Recorded through Azizam on {recordedOn}.</figcaption>
      </figure>
    </section>

    <section id="developers" class="chapter wrap" aria-labelledby="developers-title">
      <p class="eyebrow">Developers</p>
      <h2 id="developers-title">Point an existing client at it</h2>
      <p class="chapter-lede">
        Use a key from your gateway with any OpenAI-compatible client. Use a model name your gateway serves; <code>GET /v1/models</code> lists them.
      </p>
      <pre class="snippet" tabindex="0" aria-label="Example chat request"><code>{`curl http://127.0.0.1:5000/openai/v1/chat/completions \\
  -H "Authorization: Bearer $AZIZAM_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"model": "current-fast", "messages": [{"role": "user", "content": "Plan a 20-minute dinner for four."}], "max_tokens": 300}'`}</code></pre>
      <dl class="routes">
        <div><dt>OpenAI-compatible</dt><dd><code>/openai/v1</code></dd></div>
        <div><dt>Anthropic Messages</dt><dd><code>/anthropic/v1/messages</code></dd></div>
        <div><dt>Ollama-compatible</dt><dd><code>/ollama/api</code></dd></div>
        <div><dt>MCP for agents</dt><dd><code>/mcp</code></dd></div>
      </dl>
      <p class="chapter-links"><a href="/docs/api/">API guides</a> list each route's supported methods and limits. <a href="/docs/start/install/">Setup guide</a></p>
    </section>

    <section id="how" class="chapter wrap" aria-labelledby="how-title">
      <h2 id="how-title">How a request moves</h2>
      <ol class="flow">
        <li><span class="flow-name">Your apps and people</span></li>
        <li class="flow-arrow" aria-hidden="true">→</li>
        <li><span class="flow-name">Azizam</span> checks the key and plan, and records a receipt</li>
        <li class="flow-arrow" aria-hidden="true">→</li>
        <li><span class="flow-name">Your engines</span>, or a provider the plan allows</li>
      </ol>
    </section>

    <section id="limits" class="chapter wrap" aria-labelledby="limits-title">
      <h2 id="limits-title">Before you rely on it</h2>
      <ul class="facts">
        <li>You supply and maintain your engines and model files. Azizam connects to them; it does not install them.</li>
        <li>Compatibility depends on the route. The <a href="/docs/api/">API guides</a> list supported methods and their limits.</li>
        <li>Spend caps use recorded spend. Requests already running can exceed a cap before their final cost is known. Set a provider credit limit too.</li>
        <li>You run the host, including updates, backups, and HTTPS for access from other devices.</li>
      </ul>
    </section>
  </main>
</Base>
