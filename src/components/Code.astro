---
interface Props { code: string; label: string; copy?: boolean; }
const { code, label, copy = true } = Astro.props;
---
<div class="code-block">
  <div class="code-top"><span>{label}</span>{copy && <button class="copy-button" data-copy aria-label={`Copy ${label}`} type="button">Copy <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></svg></button>}</div>
  <pre tabindex="0" aria-label={label}><code>{code}</code></pre>
</div>
