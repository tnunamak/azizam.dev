---
import Code from '../components/Code.astro';
import Fish from '../components/Fish.astro';
import ProductShot from '../components/ProductShot.astro';
import { PRODUCT_NAME, PUBLIC_SOURCE, GITHUB_URL, DESCRIPTION, QUICKSTART } from '../config';
import '../styles/global.css';
const title = `${PRODUCT_NAME} — Your own AI provider`;
const setupCTA = PUBLIC_SOURCE ? 'Install your gateway' : 'View preview setup';
const tools = ['OpenAI SDKs', 'Anthropic SDK', 'Ollama clients', 'Open WebUI', 'LibreChat', 'SillyTavern', 'Cursor', 'Codex', 'Claude Code', 'MCP', 'A1111 clients', 'OpenAI Realtime'];
const protocols = [
 {name: 'OpenAI', path: '/openai/v1', code: `from openai import OpenAI\n\nclient = OpenAI(\n    base_url="http://localhost:5000/openai/v1",\n    api_key="opk_YOUR_KEY_HERE",\n)\n\nresponse = client.chat.completions.create(\n    model="llama3",\n    messages=[{"role": "user", "content": "Hello"}],\n)`},
 {name: 'Anthropic', path: '/anthropic/v1', code: `import anthropic\n\nclient = anthropic.Anthropic(\n    base_url="http://localhost:5000/anthropic",\n    api_key="opk_YOUR_KEY_HERE",\n)\n\nresponse = client.messages.create(\n    model="llama3", max_tokens=256,\n    messages=[{"role": "user", "content": "Hello"}],\n)`},
 {name: 'Ollama', path: '/ollama/api', code: `curl http://localhost:5000/ollama/api/chat \\\n  -H "Authorization: Bearer opk_YOUR_KEY_HERE" \\\n  -H "Content-Type: application/json" \\\n  -d '{\n    "model": "llama3",\n    "stream": false,\n    "messages": [{"role": "user", "content": "Hello"}]\n  }'`},
];
const faqs = [
 ['What hardware do I need?', 'The gateway routes requests; your engines do the inference. Start with an existing CPU or GPU engine, or an explicitly configured remote provider. Model size, image resolution and video workloads determine memory needs. You supply engines and model files. Configured lifecycle controls can start services or activate models.'],
 ['Does my data stay on my hardware?', 'Requests to local routes go to your configured local engines. Requests to remote routes leave your hardware. You choose and permit those routes; the gateway never silently turns a local request into a paid one. Clients and engines have their own network behavior. Generated media may retain prompts and workflow metadata.'],
 ['What does it cost?', 'Local routes have no remote provider charge; you still pay for hardware and electricity. Remote providers charge their own rates. Spending caps reject new paid requests once recorded spend reaches the cap. Calls already in flight can exceed it; see the bounded-overshoot explanation in the Providers section. This preview offers no hosted subscription.'],
 ['Which clients can I connect?', 'Clients that let you configure a supported base URL and API key. OpenAI, Anthropic, Ollama, A1111, Realtime and MCP interfaces cover supported subsets. The names above indicate compatible interfaces, not certification of every client version or vendor feature. The gateway README documents an operation-by-operation route matrix. Public source access has not been verified for this preview.'],
 ['How is this different from LiteLLM?', `LiteLLM supplies model and provider adapters and is part of the execution path. ${PRODUCT_NAME} adds protocol facades, local-engine and workflow discovery, people and access plans, media handling and request receipts around that substrate.`],
 ['How is this different from Ollama or Open WebUI?', `Ollama runs models. Open WebUI is a frontend. ${PRODUCT_NAME} connects existing frontends to existing engines, with shared access controls and supported API interfaces. Keep using both.`],
 ['Can I share it with my household?', 'Yes. Built-in email and password accounts and owner-created invitation links ship alongside optional OIDC sign-in. Give each person an access plan and their own apps and keys. Invites are private, with expiry; this is not an open signup service. Passkeys are not implemented.'],
 ['What do the screenshots prove?', 'They show the shipped app from an isolated, seeded gateway, captured in light and dark themes. Test data is labeled; empty screens are preserved. The Try view shows the shipped request panel before a run, not a measured inference result. Local decisions and provider spending controls are separately backed by source and hermetic tests.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#f6f4ec" />
    <title>{title}</title>
    <link rel="canonical" href="https://azizam.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://azizam.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content="https://azizam.dev/images/product/home-light.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>try{const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a href="#" class="brand" aria-label={`${PRODUCT_NAME} home`}><Fish /><span>{PRODUCT_NAME}</span></a>
      <nav aria-label="Main navigation"><a href="#features">The product</a><a href="#builders">For builders</a><a href="#faq">FAQ</a><button id="theme-toggle" type="button" aria-label="Switch color theme"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16M12 4a8 8 0 0 1 0 16Z"/></svg></button><a class="nav-install" href="#install">{setupCTA} <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">Your apps.<br />Your engines.<br /><em>Speaking clearly.</em></h1>
          <p class="hero-intro">Your favorite frontend.<br />Your favorite backend.</p>
          <p class="hero-description">Put {PRODUCT_NAME} in the middle so they speak clearly. One endpoint for your apps and agents, your local AI engines, and remote providers you choose.</p>
          <div class="hero-actions"><a class="button primary" href="#install">Make it your own <span aria-hidden="true">↗</span></a><a class="text-link" href="#product">See the gateway <span aria-hidden="true">↓</span></a></div>
          <p class="small-note">Self-hosted. Bring your engines. Keep your apps.</p>
        </div>
        <div class="signal-diagram" role="img" aria-label={`Your existing apps send requests through ${PRODUCT_NAME} to your local engines. Remote providers require an explicit route and permission.`}>
          <div class="signal-side"><span>Your frontends</span><strong>Apps &amp; agents</strong><p>Open WebUI<br />Coding tools<br />Vendor SDKs</p></div>
          <div class="signal-middle"><div class="signal-track"><i></i></div><div class="signal-hub"><Fish size={60} /><strong>{PRODUCT_NAME}</strong><span>Your own AI provider</span></div><div class="signal-track outbound"><i></i></div></div>
          <div class="signal-side engines"><span>Your backends</span><strong>Local engines</strong><p>Ollama · llama.cpp<br />ComfyUI · speech</p><div class="remote-branch"><strong>Remote, by choice</strong><span>Explicit route + access</span></div></div>
          <div class="signal-legend">A request moves through. Your choices stay yours.</div>
        </div>
      </section>
      <section class="compatibility container" aria-labelledby="works-heading"><h2 id="works-heading">Works with the interfaces your tools already speak</h2><div class="tool-strip">{tools.map(tool => <span>{tool}</span>)}</div><p class="small-note">Supported subsets of compatible protocols. Independent projects; client versions and methods vary.</p></section>
      <section id="product" class="product-intro container" aria-labelledby="product-heading"><div class="section-intro"><h2 id="product-heading">Your whole stack.<br />A clearer picture.</h2><p>Connect an app. Choose a model. Check a request. The same gateway serves the person at the screen and the agent at the API.</p></div><div class="hero-proof"><ProductShot surface="home" eager alt="Azizam Home in the shipped app, with connection settings and the first-run checklist" caption="Shipped Home · isolated seeded gateway · October 2026. Test data, not a live instance." /></div></section>
      <section id="features" class="features container" aria-labelledby="features-heading">
        <h2 id="features-heading" class="sr-only">Inside the gateway</h2>
        <article class="feature-row"><div class="feature-copy"><h3>Find the model.<br />Keep the interface.</h3><p>Browse models by capability. See their local or remote route, then use a stable alias in the client you already know.</p><div class="modality-list"><span>Chat</span><span>Images</span><span>Video</span><span>Voice</span><span>Transcription</span><span>Decisions</span><span>Embeddings</span><span>Rerank</span></div><p class="small-note">Availability follows your configured engines, providers and access plan. No engines or models are included.</p></div><ProductShot surface="models" alt="The shipped Models catalog groups available models by capability" caption="Models · seeded product capture. Routes and availability depend on your setup." /></article>
        <article class="feature-row reverse"><div class="feature-copy"><h3>A friendly API.<br />Room for real control.</h3><p>Named workflows expose typed inputs, outputs and engine bindings. Discover the controls before you run them, and keep the native escape hatch when you need it.</p><p>ComfyUI workflows stay workflows. An image API does not have to hide the details that matter.</p><p class="small-note">The machine-readable workflow catalog uses the same manifests as the UI.</p></div><ProductShot surface="workflows" alt="Workflows in the real app, showing the shipped catalog and workflow controls" caption="Workflows · isolated seeded gateway. Installed manifests determine the catalog." /></article>
        <article class="feature-row"><div class="feature-copy"><h3>Ask for a decision.<br />Get a typed answer.</h3><p>Local decisions now ship, through a TypeSafe-compatible <code>/v1/systemone</code> API. Use a configured local decider, or explicitly choose a remote TypeSafe route.</p><p>Try makes a small API request and shows the result. Copy the request into your own code when it works.</p><p class="small-note">The screenshot shows the shipped Try request panel before a run. It does not claim inference speed or quality.</p></div><ProductShot surface="try" alt="Try request panel in the shipped Azizam UI" caption="Try · seeded request panel in the real app. No timing benchmark claimed." /></article>
      </section>
      <section id="providers" class="local-section" aria-labelledby="local-heading"><div class="container"><div class="local-inner"><div><h2 id="local-heading">Local first.<br />Paid on purpose.</h2><p>A local request never quietly becomes a paid one. A remote route needs an explicit model or alias and access-plan permission.</p><p>Configure provider registry entries in Providers. The page shows readiness, key-reference status and recorded spend, with controls for models, caps and allowed plans.</p><p class="local-note">Provider secrets stay write-only or environment-backed. The screenshot uses a seeded disabled provider; no paid request was made.</p></div><ProductShot surface="providers" alt="Providers in the shipped app showing a disabled test provider and its configuration status" caption="Providers · seeded, disabled OpenRouter entry. No paid requests were made." /></div><div class="spending-note"><h3>A spending cap with an honest boundary.</h3><p id="cap-explanation">New paid calls stop when recorded spend reaches the cap. A cap can be exceeded by at most the actual cost of requests already in flight when it was reached. This is a bounded-overshoot guarantee, not a hard invoice ceiling; capped paid requests need a bounded cost estimate. Unknown final costs keep their reservation until reconciled.</p></div></div></section>
      <section class="container"><article class="feature-row"><div class="feature-copy"><h3>Keep what you make.<br />See where it came from.</h3><p>Library gathers your generated images, video and audio. Inspect available prompt, model and workflow metadata, then download or remove your own assets.</p><p class="small-note">The captured test library is empty. Provenance is unsigned; delivered metadata can be stripped. Receipt coverage varies by route.</p></div><ProductShot surface="library" alt="Library's honest empty state in the real shipped app" caption="Library · real empty state. Your own generated media fills this view." /></article><article class="feature-row reverse"><div class="feature-copy"><h3>When it fails,<br />start with what is true.</h3><p>See engine health and request activity. Distinguish missing, unavailable and unknown instead of treating a configured service as a working one.</p><p>Use receipts to inspect the route, policy and accepted controls recorded for a request.</p><p class="small-note">Health observations describe the gateway and configured services. They do not certify a third-party client's setup.</p></div><ProductShot surface="status" alt="Status in the shipped app with observed health and service information" caption="Status · observed test-instance state, not production telemetry." /></article></section>
      <section id="households" class="household-section container" aria-labelledby="households-heading"><div class="feature-row"><div class="feature-copy"><h2 id="households-heading">Your gateway.<br />Their own access.</h2><p>Invite the people you trust. Built-in email and password accounts work alongside optional OIDC, so sharing does not require a separate identity server.</p><p>Give each person an access plan, apps and keys. Choose the models and workflows they may use, then revoke access when you need to.</p><p class="small-note">Owner-created invitations have expiry. Invite-only access; passkeys are not implemented.</p></div><ProductShot surface="people" alt="People and invitation controls in the real Azizam owner UI" caption="People · seeded test accounts. Owner controls for people, invites and access plans." /></div></section>
      <section id="builders" class="builders-section container" aria-labelledby="builders-heading"><div class="section-intro"><h2 id="builders-heading">For builders.<br />And the agents they build.</h2><p>Known protocol shapes. Discoverable workflows. Explicit errors. A gateway you can inspect and script.</p></div><article class="feature-row"><div class="feature-copy"><h3>One key.<br />Familiar requests.</h3><p>Use supported OpenAI, Anthropic and Ollama interfaces, plus A1111, Realtime and MCP routes. Set the base URL and choose a model your gateway actually exposes.</p><dl class="protocol-list"><div><dt>Workflow discovery</dt><dd>/gateway/v1/workflows</dd></div><div><dt>Decisions</dt><dd>/v1/systemone</dd></div><div><dt>MCP</dt><dd>/mcp</dd></div></dl><p class="small-note">Examples are illustrative. Replace the key and model with your own. Vendor compatibility covers supported subsets.</p></div><div class="protocol-demo"><div class="tabs" role="tablist" aria-label="Protocol examples">{protocols.map((protocol, i) => <button id={`tab-${i}`} class="protocol-tab" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${i}`} tabindex={i === 0 ? 0 : -1}>{protocol.name}</button>)}</div>{protocols.map((protocol, i) => <div id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`}><Code code={protocol.code} label={`Python / curl example · ${protocol.path}`} /></div>)}</div></article></section>
      <section id="install" class="install-section container" aria-labelledby="install-heading"><div class="install-copy"><h2 id="install-heading">Bring your stack.<br />Make the connection.</h2><p>The README quickstart starts the gateway with Docker Compose. Engines stay yours.</p><ol><li><strong>Start the gateway.</strong><span>Run the commands. The Compose stack includes the gateway's LiteLLM sidecar.</span></li><li><strong>Claim it.</strong><span>Open <code>127.0.0.1:5000/setup</code>. Create the owner account and your first app key.</span></li><li><strong>Connect an engine, then an app.</strong><span>Add your existing engine in Gateway → Engines. Make a real request, then copy your settings into a client.</span></li></ol></div><div>{!PUBLIC_SOURCE && <p class="small-note">Setup requires access to the private Azizam repository.</p>}<Code code={QUICKSTART} label="Docker Compose · README quickstart" /><p id="source-note" class="small-note">{PUBLIC_SOURCE ? 'The gateway source is available on GitHub.' : 'Unlisted preview. The Azizam repository is private.'} {GITHUB_URL && <a href={GITHUB_URL}>Read the source.</a>} Engine and model setup time depends on your hardware.</p></div></section>
      <section id="faq" class="faq-section container" aria-labelledby="faq-heading"><h2 id="faq-heading">Good questions.<br />Straight answers.</h2><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></summary><p>{answer}</p></details>)}</div></section>
      <section class="closing container"><div><Fish size={48} /><h2>Your apps. Your engines.<br />Speaking clearly.</h2></div><a class="button primary" href="#install">{setupCTA} <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="container"><div><span class="footer-brand">{PRODUCT_NAME}</span><p>Your own AI provider. Local first, remote by choice.</p></div><nav aria-label="Footer navigation"><a href="#features">Product</a><a href="#install">Install</a><a href="#faq">FAQ</a>{GITHUB_URL && <a href={GITHUB_URL}>GitHub</a>}</nav><small>Unlisted preview · October 2026</small></footer>
    <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const updateThemeLabel = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        document.querySelectorAll<HTMLSourceElement>('[data-theme-image]').forEach(source => source.media = dark ? '(min-width: 0px)' : '(max-width: 0px)');
        if (toggle) toggle.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`); };
      updateThemeLabel();
      toggle?.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('theme', theme); } catch {} updateThemeLabel(); });
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.protocol-tab'));
      function selectTab(index: number) { tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; const panel = document.getElementById(tab.getAttribute('aria-controls')!); if (panel) panel.hidden = i !== index; }); }
      selectTab(0);
      tabs.forEach((tab, i) => { tab.addEventListener('click', () => selectTab(i)); tab.addEventListener('keydown', (event) => { let next = i; if (event.key === 'ArrowRight') next = (i + 1) % tabs.length; else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length; else if (event.key === 'Home') next = 0; else if (event.key === 'End') next = tabs.length - 1; else return; event.preventDefault(); selectTab(next); tabs[next].focus(); }); });
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => { const code = button.closest('.code-block')?.querySelector('code')?.textContent; if (!code) return; try { if (navigator.clipboard) { await navigator.clipboard.writeText(code); } else { const field = document.createElement('textarea'); field.value = code; field.setAttribute('aria-hidden', 'true'); field.style.position = 'fixed'; field.style.left = '-9999px'; document.body.append(field); field.select(); const copied = document.execCommand('copy'); field.remove(); button.focus(); if (!copied) throw new Error('Clipboard unavailable'); } button.textContent = 'Copied'; const status = document.querySelector('#copy-status'); if (status) status.textContent = 'Code copied to clipboard.'; setTimeout(() => { button.textContent = 'Copy'; }, 2000); } catch { button.textContent = 'Select code to copy'; const status = document.querySelector('#copy-status'); if (status) status.textContent = 'Clipboard unavailable. Select the code and copy it manually.'; } }));
    </script>
  </body>
</html>
